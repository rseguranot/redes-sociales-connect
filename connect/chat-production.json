{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Production WhatsApp AI, independent of voice and test Lex resources",
  "Parameters": {
    "ConnectInstanceArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:connect:[a-z0-9-]+:[0-9]{12}:instance/[a-f0-9-]+$"
    },
    "AssistantArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:wisdom:.*:assistant/.*$"
    },
    "AssistantKmsKeyArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:kms:.*:key/.*$"
    },
    "ConfigBedrockReclamacionesAgentId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigBedrockConsultaAgentId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigSupervisorAgentId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigBedrockReclamacionesAgentAliasId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigBedrockQuejasAgentAliasId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigSupervisorAgentAliasId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigBedrockConsultaAgentAliasId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigBedrockQuejasAgentId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigQconnectAssistantId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigQconnectAssociationId": {
      "Type": "String",
      "MinLength": 1
    },
    "ConfigAmazonQIntentName": {
      "Type": "String",
      "MinLength": 1
    },
    "QueueArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:connect:.*:instance/.*/queue/.*$"
    },
    "HoursArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:connect:.*:instance/.*/operating-hours/.*$"
    },
    "AiAgentArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:wisdom:.*:ai-agent/.*$"
    },
    "AlarmTopicArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:sns:.*$"
    },
    "FlowName": {
      "Type": "String",
      "Default": "00 PROD WhatsApp AI - Atención",
      "MinLength": 1
    },
    "NoTransferSocialUserId": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Stable social user ID allowed to test handoff without reaching an agent"
    },
    "NoTransferPhoneNumber1": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{7,15}$",
      "Description": "Explicit test phone allowed to suppress agent transfer"
    },
    "NoTransferPhoneNumber2": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{7,15}$",
      "Description": "Explicit test phone allowed to suppress agent transfer"
    }
  },
  "Resources": {
    "ConnectChatAssociation": {
      "Type": "AWS::Connect::IntegrationAssociation",
      "DependsOn": "AliasPolicy",
      "Properties": {
        "InstanceId": {
          "Ref": "ConnectInstanceArn"
        },
        "IntegrationArn": {
          "Fn::GetAtt": [
            "ChatAlias",
            "Arn"
          ]
        },
        "IntegrationType": "LEX_BOT"
      }
    },
    "ChatAdapter": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "CodeUri": "../src/chat_adapter/",
        "Handler": "app.lambda_handler",
        "Runtime": "python3.14",
        "Architectures": [
          "arm64"
        ],
        "Timeout": 55,
        "MemorySize": 256,
        "Environment": {
          "Variables": {
            "BUSINESS_HOOK_ARN": {
              "Fn::Sub": "${BusinessHook.Arn}:chat"
            },
            "CONTACT_CONTEXT_INSTANCE_ID": {
              "Fn::Select": [
                1,
                {
                  "Fn::Split": [
                    "instance/",
                    {
                      "Ref": "ConnectInstanceArn"
                    }
                  ]
                }
              ]
            }
          }
        },
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "lambda:InvokeFunction",
                "Resource": {
                  "Fn::Sub": "${BusinessHook.Arn}:chat"
                }
              },
              {
                "Effect": "Allow",
                "Action": "connect:UpdateContactAttributes",
                "Resource": {
                  "Fn::Sub": "${ConnectInstanceArn}/contact/*"
                }
              }
            ]
          }
        ],
        "ReservedConcurrentExecutions": 20
      },
      "DependsOn": "BusinessHookAliaschat"
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ChatAdapter}"
        },
        "RetentionInDays": 30
      }
    },
    "ChatAlias": {
      "Type": "AWS::Lex::BotAlias",
      "Properties": {
        "BotAliasName": "whatsapp_chat_prod",
        "BotId": {
          "Ref": "ChatBot"
        },
        "BotVersion": {
          "Fn::GetAtt": [
            "ChatVersion",
            "BotVersion"
          ]
        },
        "Description": "WhatsApp chat formatting and contextual interactive responses",
        "BotAliasLocaleSettings": [
          {
            "LocaleId": "es_US",
            "BotAliasLocaleSetting": {
              "Enabled": true,
              "CodeHookSpecification": {
                "LambdaCodeHook": {
                  "CodeHookInterfaceVersion": "1.0",
                  "LambdaArn": {
                    "Fn::GetAtt": [
                      "ChatAdapter",
                      "Arn"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "LexPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ChatAdapter"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "lexv2.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::GetAtt": [
            "ChatAlias",
            "Arn"
          ]
        }
      }
    },
    "AliasPolicy": {
      "Type": "AWS::Lex::ResourcePolicy",
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": [
            "ChatAlias",
            "Arn"
          ]
        },
        "Policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "connect.amazonaws.com"
              },
              "Action": [
                "lex:RecognizeText",
                "lex:StartConversation",
                "lex:RecognizeMessageAsync"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "ChatAlias",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "AWS:SourceArn": {
                    "Ref": "ConnectInstanceArn"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BusinessHook": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "CodeUri": "../src/chat_business/",
        "Handler": "lambda_function.lambda_handler",
        "Runtime": "python3.14",
        "Architectures": [
          "arm64"
        ],
        "Timeout": 40,
        "MemorySize": 512,
        "AutoPublishAlias": "chat",
        "Environment": {
          "Variables": {
            "APP_ENV": "chat-prod",
            "BEDROCK_SESSION_PREFIX": "chat-prod",
            "BEDROCK_RECLAMACIONES_AGENT_ID": {
              "Ref": "ConfigBedrockReclamacionesAgentId"
            },
            "BEDROCK_CONSULTA_AGENT_ID": {
              "Ref": "ConfigBedrockConsultaAgentId"
            },
            "SUPERVISOR_AGENT_ID": {
              "Ref": "ConfigSupervisorAgentId"
            },
            "BEDROCK_RECLAMACIONES_AGENT_ALIAS_ID": {
              "Ref": "ConfigBedrockReclamacionesAgentAliasId"
            },
            "BEDROCK_QUEJAS_AGENT_ALIAS_ID": {
              "Ref": "ConfigBedrockQuejasAgentAliasId"
            },
            "SUPERVISOR_AGENT_ALIAS_ID": {
              "Ref": "ConfigSupervisorAgentAliasId"
            },
            "BEDROCK_CONSULTA_AGENT_ALIAS_ID": {
              "Ref": "ConfigBedrockConsultaAgentAliasId"
            },
            "BEDROCK_QUEJAS_AGENT_ID": {
              "Ref": "ConfigBedrockQuejasAgentId"
            },
            "QCONNECT_ASSISTANT_ID": {
              "Ref": "ConfigQconnectAssistantId"
            },
            "QCONNECT_ASSOCIATION_ID": {
              "Ref": "ConfigQconnectAssociationId"
            },
            "AMAZON_Q_INTENT_NAME": {
              "Ref": "ConfigAmazonQIntentName"
            }
          }
        },
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "wisdom:Retrieve",
                "Resource": {
                  "Ref": "AssistantArn"
                }
              },
              {
                "Effect": "Allow",
                "Action": "kms:Decrypt",
                "Resource": {
                  "Ref": "AssistantKmsKeyArn"
                }
              },
              {
                "Effect": "Allow",
                "Action": "bedrock:InvokeAgent",
                "Resource": [
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:agent-alias/${ConfigBedrockQuejasAgentId}/${ConfigBedrockQuejasAgentAliasId}"
                  },
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:agent-alias/${ConfigBedrockReclamacionesAgentId}/${ConfigBedrockReclamacionesAgentAliasId}"
                  },
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:agent-alias/${ConfigBedrockConsultaAgentId}/${ConfigBedrockConsultaAgentAliasId}"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": "bedrock:InvokeModel",
                "Resource": {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.nova-micro-v1:0"
                }
              }
            ]
          }
        ],
        "ReservedConcurrentExecutions": 20
      }
    },
    "BusinessLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${BusinessHook}"
        },
        "RetentionInDays": 30
      }
    },
    "BotRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lexv2.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:lex:${AWS::Region}:${AWS::AccountId}:bot-alias/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedChatAssistant",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "wisdom:CreateSession",
                    "wisdom:GetAssistant"
                  ],
                  "Resource": [
                    {
                      "Ref": "AssistantArn"
                    },
                    {
                      "Fn::Sub": "${AssistantArn}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "wisdom:SendMessage",
                    "wisdom:GetNextMessage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:wisdom:${AWS::Region}:${AWS::AccountId}:session/${ConfigQconnectAssistantId}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Ref": "AssistantKmsKeyArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ChatBot": {
      "Type": "AWS::Lex::Bot",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-bot"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "BotRole",
            "Arn"
          ]
        },
        "DataPrivacy": {
          "ChildDirected": false
        },
        "IdleSessionTTLInSeconds": 900,
        "AutoBuildBotLocales": true,
        "Description": "Independent WhatsApp chat bot; voice is not modified",
        "BotLocales": [
          {
            "LocaleId": "es_US",
            "NluConfidenceThreshold": 0.4,
            "Intents": [
