    "ProductionContactFlow": {
      "Type": "AWS::Connect::ContactFlow",
      "DependsOn": "ConnectChatAssociation",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "InstanceArn": {
          "Ref": "ConnectInstanceArn"
        },
        "Name": {
          "Ref": "FlowName"
        },
        "Description": "Production WhatsApp AI and real agent handoff with persisted contact context",
        "State": "ACTIVE",
        "Type": "CONTACT_FLOW",
        "Content": {
          "Fn::Sub": "{\"Version\": \"2019-10-30\", \"StartAction\": \"EnableLogging\", \"Metadata\": {\"entryPointPosition\": {\"x\": 40, \"y\": 40}, \"ActionMetadata\": {}, \"Annotations\": []}, \"Actions\": [{\"Identifier\": \"EnableLogging\", \"Type\": \"UpdateFlowLoggingBehavior\", \"Parameters\": {\"FlowLoggingBehavior\": \"Disabled\"}, \"Transitions\": {\"NextAction\": \"SetLanguage\"}}, {\"Identifier\": \"SetLanguage\", \"Type\": \"UpdateContactData\", \"Parameters\": {\"LanguageCode\": \"es-US\"}, \"Transitions\": {\"NextAction\": \"SetWorkingQueue\", \"Errors\": [{\"NextAction\": \"SetWorkingQueue\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"SetWorkingQueue\", \"Type\": \"UpdateContactTargetQueue\", \"Parameters\": {\"QueueId\": \"${QueueArn}\"}, \"Transitions\": {\"NextAction\": \"CreateAiSession\", \"Errors\": [{\"NextAction\": \"CreateAiSession\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"CheckNoTransferIdentity\", \"Type\": \"Compare\", \"Parameters\": {\"ComparisonValue\": \"$.Attributes.social_user_id\"}, \"Transitions\": {\"NextAction\": \"CheckNoTransferPhone1\", \"Conditions\": [{\"NextAction\": \"PersonalTestGreeting\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"${NoTransferSocialUserId}\"]}}], \"Errors\": [{\"NextAction\": \"CheckNoTransferPhone1\", \"ErrorType\": \"NoMatchingCondition\"}]}}, {\"Identifier\": \"PersonalTestGreeting\", \"Type\": \"MessageParticipant\", \"Parameters\": {\"Text\": \"Prueba completada. Esta conversación finalizará sin transferirse a un representante.\"}, \"Transitions\": {\"NextAction\": \"MarkTestComplete\", \"Errors\": [{\"NextAction\": \"MarkTestComplete\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"MarkTestComplete\", \"Type\": \"UpdateContactAttributes\", \"Parameters\": {\"Attributes\": {\"bot_branch_outcome\": \"TEST_HANDOFF_SUPPRESSED\", \"bot_handoff_requested\": \"true\", \"transfer_suppressed\": \"true\", \"social_handoff_requested\": \"true\", \"representante\": \"true\"}, \"TargetContact\": \"Current\"}, \"Transitions\": {\"NextAction\": \"Disconnect\", \"Errors\": [{\"NextAction\": \"Disconnect\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"CreateAiSession\", \"Type\": \"CreateWisdomSession\", \"Parameters\": {\"WisdomAssistantArn\": \"${AssistantArn}\"}, \"Transitions\": {\"NextAction\": \"BindAiSession\", \"Errors\": [{\"NextAction\": \"AiErrorMessage\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"BindAiSession\", \"Type\": \"UpdateContactData\", \"Parameters\": {\"WisdomSessionArn\": \"$.Wisdom.SessionArn\"}, \"Transitions\": {\"NextAction\": \"AiBot\", \"Errors\": [{\"NextAction\": \"AiErrorMessage\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"AiBot\", \"Type\": \"ConnectParticipantWithLexBot\", \"Parameters\": {\"Text\": \"{\\\"whatsapp_outbound\\\": {\\\"type\\\": \\\"interactive\\\", \\\"interactive\\\": {\\\"type\\\": \\\"list\\\", \\\"header\\\": {\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"Plaza Lama\\\"}, \\\"body\\\": {\\\"text\\\": \\\"Gracias por comunicarse con Plaza Lama, la Súper Tienda. Soy su asistente virtual. Elija una opción o escriba su consulta.\\\"}, \\\"action\\\": {\\\"button\\\": \\\"Ver opciones\\\", \\\"sections\\\": [{\\\"title\\\": \\\"Menú principal\\\", \\\"rows\\\": [{\\\"id\\\": \\\"dev_ai_general\\\", \\\"title\\\": \\\"Información general\\\", \\\"description\\\": \\\"Productos, precios, tiendas y horarios\\\"}, {\\\"id\\\": \\\"dev_ai_estatus\\\", \\\"title\\\": \\\"Estatus de mi pedido\\\", \\\"description\\\": \\\"Consultar pedido o entrega\\\"}, {\\\"id\\\": \\\"dev_ai_reclamacion\\\", \\\"title\\\": \\\"Tengo una reclamación\\\", \\\"description\\\": \\\"Producto, compra o caso existente\\\"}, {\\\"id\\\": \\\"dev_ai_queja\\\", \\\"title\\\": \\\"Tengo una queja\\\", \\\"description\\\": \\\"Reportar una situación de servicio\\\"}]}, {\\\"title\\\": \\\"Otras opciones\\\", \\\"rows\\\": [{\\\"id\\\": \\\"dev_ai_agent\\\", \\\"title\\\": \\\"Hablar con un agente\\\", \\\"description\\\": \\\"Atención con representante\\\"}]}]}}}}\", \"LexV2Bot\": {\"AliasArn\": \"${ChatAlias.Arn}\"}, \"LexSessionAttributes\": {\"x-amz-lex:q-in-connect:ai-agent-arn\": \"${AiAgentArn}\", \"social_connect_contact_id\": \"$.ContactId\"}}, \"Transitions\": {\"NextAction\": \"CaptureAiOutcome\", \"Conditions\": [{\"NextAction\": \"CheckNoTransferIdentity\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"AgenteHumano\"]}}, {\"NextAction\": \"CheckNoTransferIdentity\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"Agentehumano\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"AmazonQinConnect\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"FallbackIntent\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"consulta\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"Quejas\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"reclamaciones\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"Genera\"]}}, {\"NextAction\": \"CaptureAiOutcome\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"Cerrar\"]}}], \"Errors\": [{\"NextAction\": \"CaptureAiOutcome\", \"ErrorType\": \"NoMatchingCondition\"}, {\"NextAction\": \"AiErrorMessage\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"CaptureAiOutcome\", \"Type\": \"UpdateContactAttributes\", \"Parameters\": {\"Attributes\": {\"flujo\": \"$.Lex.SessionAttributes.origen_actual\", \"representante\": \"$.Lex.SessionAttributes.agente\", \"social_context_status\": \"$.Lex.SessionAttributes.social_context_status\"}, \"TargetContact\": \"Current\"}, \"Transitions\": {\"NextAction\": \"CheckHandoff\", \"Errors\": [{\"NextAction\": \"CheckHandoff\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"CheckHandoff\", \"Type\": \"Compare\", \"Parameters\": {\"ComparisonValue\": \"$.Lex.SessionAttributes.agente\"}, \"Transitions\": {\"NextAction\": \"MarkComplete\", \"Conditions\": [{\"NextAction\": \"CheckNoTransferIdentity\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"true\"]}}, {\"NextAction\": \"MarkComplete\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"false\"]}}], \"Errors\": [{\"NextAction\": \"MarkComplete\", \"ErrorType\": \"NoMatchingCondition\"}]}}, {\"Identifier\": \"CheckHours\", \"Type\": \"CheckHoursOfOperation\", \"Parameters\": {\"HoursOfOperationId\": \"${HoursArn}\"}, \"Transitions\": {\"NextAction\": \"ClosedMessage\", \"Conditions\": [{\"NextAction\": \"MarkHandoff\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"True\"]}}, {\"NextAction\": \"ClosedMessage\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"False\"]}}], \"Errors\": [{\"NextAction\": \"ClosedMessage\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"MarkHandoff\", \"Type\": \"UpdateContactAttributes\", \"Parameters\": {\"Attributes\": {\"bot_branch_outcome\": \"ASSISTED_CANDIDATE\", \"bot_handoff_requested\": \"true\", \"social_handoff_requested\": \"true\", \"representante\": \"true\"}, \"TargetContact\": \"Current\"}, \"Transitions\": {\"NextAction\": \"TransferToQueue\", \"Errors\": [{\"NextAction\": \"TransferToQueue\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"TransferToQueue\", \"Type\": \"TransferContactToQueue\", \"Parameters\": {}, \"Transitions\": {\"NextAction\": \"Disconnect\", \"Errors\": [{\"NextAction\": \"QueueUnavailable\", \"ErrorType\": \"QueueAtCapacity\"}, {\"NextAction\": \"QueueUnavailable\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"ClosedMessage\", \"Type\": \"MessageParticipant\", \"Parameters\": {\"Text\": \"En este momento no estamos dentro del horario de atención de representantes. Su conversación queda registrada. Por favor, vuelva a escribirnos durante nuestro horario de atención.\"}, \"Transitions\": {\"NextAction\": \"Disconnect\", \"Errors\": [{\"NextAction\": \"Disconnect\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"AiErrorMessage\", \"Type\": \"MessageParticipant\", \"Parameters\": {\"Text\": \"No pude continuar la atención automática. Intentaré comunicarle con un representante.\"}, \"Transitions\": {\"NextAction\": \"MarkError\", \"Errors\": [{\"NextAction\": \"MarkError\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"MarkError\", \"Type\": \"UpdateContactAttributes\", \"Parameters\": {\"Attributes\": {\"bot_branch_outcome\": \"ERROR\", \"bot_outcome\": \"ERROR\"}, \"TargetContact\": \"Current\"}, \"Transitions\": {\"NextAction\": \"CheckNoTransferIdentity\", \"Errors\": [{\"NextAction\": \"CheckNoTransferIdentity\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"MarkComplete\", \"Type\": \"UpdateContactAttributes\", \"Parameters\": {\"Attributes\": {\"bot_branch_outcome\": \"COMPLETED\", \"bot_outcome\": \"COMPLETED\"}, \"TargetContact\": \"Current\"}, \"Transitions\": {\"NextAction\": \"Disconnect\", \"Errors\": [{\"NextAction\": \"Disconnect\", \"ErrorType\": \"NoMatchingError\"}]}}, {\"Identifier\": \"Disconnect\", \"Type\": \"DisconnectParticipant\", \"Parameters\": {}, \"Transitions\": {}}, {\"Identifier\": \"CheckNoTransferPhone1\", \"Type\": \"Compare\", \"Parameters\": {\"ComparisonValue\": \"$.Attributes.social_phone\"}, \"Transitions\": {\"NextAction\": \"CheckNoTransferPhone2\", \"Conditions\": [{\"NextAction\": \"PersonalTestGreeting\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"${NoTransferPhoneNumber1}\"]}}], \"Errors\": [{\"NextAction\": \"CheckNoTransferPhone2\", \"ErrorType\": \"NoMatchingCondition\"}]}}, {\"Identifier\": \"CheckNoTransferPhone2\", \"Type\": \"Compare\", \"Parameters\": {\"ComparisonValue\": \"$.Attributes.social_phone\"}, \"Transitions\": {\"NextAction\": \"CheckHours\", \"Conditions\": [{\"NextAction\": \"PersonalTestGreeting\", \"Condition\": {\"Operator\": \"Equals\", \"Operands\": [\"${NoTransferPhoneNumber2}\"]}}], \"Errors\": [{\"NextAction\": \"CheckHours\", \"ErrorType\": \"NoMatchingCondition\"}]}}, {\"Identifier\": \"QueueUnavailable\", \"Type\": \"MessageParticipant\", \"Parameters\": {\"Text\": \"No fue posible conectar con la cola de atención en este momento. Su conversación queda registrada. Por favor, intente nuevamente más tarde.\"}, \"Transitions\": {\"NextAction\": \"Disconnect\", \"Errors\": [{\"NextAction\": \"Disconnect\", \"ErrorType\": \"NoMatchingError\"}]}}]}"
        }
      }
    }
  },
  "Outputs": {
